# =============================================================
# LibreChat Bot Service — Environment Variables
# Copy this file to .env inside services/bot-service/
# =============================================================

# --- LibreChat connection ---
# URL of the LibreChat API (inside docker network: http://api:3080)
LIBRECHAT_API_URL=http://api:3080

# Bot user account (create this user in LibreChat first!)
BOT_USER_EMAIL=bot@yourdomain.com
BOT_USER_PASSWORD=change_me_strong_password

# Which AI endpoint/model to use for bot responses
BOT_ENDPOINT=google
BOT_MODEL=gemini-2.0-flash

# --- Telegram ---
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# --- Discord ---
# Get from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# --- Meta / WhatsApp (coming soon) ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=

# --- Logging ---
LOG_LEVEL=info
NODE_ENV=production
